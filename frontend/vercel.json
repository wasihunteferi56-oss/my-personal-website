{
  "version": 2,
  "builds": [
    {
      "src": "backend/config/asgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/config/asgi.py"
    }
  ]
}